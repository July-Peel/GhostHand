{
  "manifest_version": 3,
  "name": "GhostHand Browser Bridge",
  "version": "1.0.0",
  "description": "GhostHand Windows Agent 浏览器 DOM 操控与 Native Messaging 桥接",
  "minimum_chrome_version": "120",
  "action": {"default_title": "GhostHand Browser Bridge", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "all_frames": true,
    "match_origin_as_fallback": true,
    "js": ["content-script.js"],
    "matches": ["http://*/*", "https://*/*", "file://*/*"],
    "run_at": "document_start"
  }],
  "permissions": ["tabs", "activeTab", "webNavigation", "nativeMessaging", "scripting", "userScripts", "cookies", "alarms"],
  "host_permissions": ["<all_urls>"],
  "key": ""
}
