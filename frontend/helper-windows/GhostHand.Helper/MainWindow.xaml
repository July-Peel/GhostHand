<Window x:Class="GhostHand.Helper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GhostHand 执行器" Width="460" Height="225"
        MinWidth="360" MinHeight="200" WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Segoe UI, Microsoft YaHei">
    <Grid Margin="28">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="GhostHand 执行器" FontSize="23" FontWeight="SemiBold" Foreground="#18181B"/>
            <Border Margin="0,18,0,0" Padding="14" CornerRadius="8"
                    Background="White" BorderBrush="#E4E4E7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="独立调试" FontWeight="SemiBold" Foreground="#4F46E5"/>
                    <TextBlock Margin="0,6,0,0" Foreground="#52525B" TextWrapping="Wrap"
                               Text="执行器已启动。安装 GhostHandSvc 后，服务将在交互会话中启动执行器并建立命名管道连接。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
